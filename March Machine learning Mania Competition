    "\n",
    "# ## 1. Load Data\n",
    "# \n",
    "# All files are located in `/kaggle/input/competitions/march-machine-learning-mania-2026/`. We'll load only the necessary ones for men's tournament.\n",
    "\n",
    "# %%\n",
    "data_dir = '/kaggle/input/competitions/march-machine-learning-mania-2026/'\n",
    "\n",
    "# Core files\n",
    "teams = pd.read_csv(data_dir + 'MTeams.csv')\n",
