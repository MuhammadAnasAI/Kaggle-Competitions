    "# Detailed stats (optional)\n",
    "reg_detailed = pd.read_csv(data_dir + 'MRegularSeasonDetailedResults.csv')\n",
    "tourney_detailed = pd.read_csv(data_dir + 'MNCAATourneyDetailedResults.csv')\n",
    "\n",
    "# Massey ordinals\n",
    "massey = pd.read_csv(data_dir + 'MMasseyOrdinals.csv')\n",
    "\n",
    "# Sample submission (contains all 2026 tournament matchups)\n",
    "sample_sub = pd.read_csv(data_dir + 'SampleSubmissionStage2.csv')\n",
    "\n",
    "print('Data loaded successfully.')\n",
    "\n",
