    "\n",
    "# ## 3. Feature Engineering\n",
    "# \n",
    "# We'll create two main sets of features:\n",
    "# - **Team‑season stats** from regular season games (compact results).\n",
    "# - **Massey rankings** – average rank for each team at the end of the regular season.\n",
    "\n",
    "# %% [markdown]\n",
    "# ### 3.1 Team‑Season Stats from Compact Results\n",
    "# \n",
    "# For each team and season, compute:\n",
    "# - Games played\n",
    "# - Wins\n",
    "# - Win percentage\n",
    "# - Average points scored\n",
    "# - Average points allowed\n",
    "# - Average score differential\n",
    "# \n",
    "# We'll create a DataFrame with columns: `Season`, `TeamID`, and these stats.\n",
    "\n",
    "# %%\n",
    "# Function to compute team-season stats\n",
    "def compute_team_stats(reg_df):\n",
    "    # Stats for winners\n",
    "    winners = reg_df[['Season', 'WTeamID', 'WScore', 'LScore']].copy()\n",
    "    winners.rename(columns={'WTeamID': 'TeamID', 'WScore': 'ScoreFor', 'LScore': 'ScoreAgainst'}, inplace=True)\n",
    "    winners['Win'] = 1\n",
    "    \n",
    "    # Stats for losers\n",
    "    losers = reg_df[['Season', 'LTeamID', 'LScore', 'WScore']].copy()\n",
    "    losers.rename(columns={'LTeamID': 'TeamID', 'LScore': 'ScoreFor', 'WScore': 'ScoreAgainst'}, inplace=True)\n",
    "    losers['Win'] = 0\n",
    "    \n",
    "    # Combine\n",
    "    all_games = pd.concat([winners, losers], ignore_index=True)\n",
    "    \n",
    "    # Aggregate\n",
    "    stats = all_games.groupby(['Season', 'TeamID']).agg(\n",
    "        Games=('Win', 'count'),\n",
    "        Wins=('Win', 'sum'),\n",
    "        AvgScoreFor=('ScoreFor', 'mean'),\n",
    "        AvgScoreAgainst=('ScoreAgainst', 'mean'),\n",
    "        AvgDiff=('ScoreFor', lambda x: (x - all_games.loc[x.index, 'ScoreAgainst']).mean())\n",
    "    ).reset_index()\n",
    "    \n",
    "    stats['WinPct'] = stats['Wins'] / stats['Games']\n",
    "    return stats\n",
    "\n",
    "team_stats = compute_team_stats(reg_compact)\n",
    "print(team_stats.head())\n",
    "\n",
    "# %% [markdown]\n",
    "# ### 3.2 Massey Rankings\n",
    "# \n",
    "# We'll use the most recent ranking before the tournament for each team each season. The tournament typically starts around day 130+, so we'll take rankings with `RankingDayNum` less than, say, 130 (or the max day for that season). To be safe, we can take the last available ranking before the tournament for each system, then average across systems.\n",
    "\n",
    "# %%\n",
    "# For each season, find the last ranking day before tournament (e.g., day < 140)\n",
    "# We'll simply take the ranking with the maximum day for each team/system that is <= 130? \n",
    "# A simpler approach: for each team and season, average the rank across all systems at the latest available day.\n",
    "\n",
    "# First, get the latest ranking day for each season from the massey data\n",
    "latest_day_per_season = massey.groupby('Season')['RankingDayNum'].max().to_dict()\n",
    "\n",
    "# For each team and season, take all rankings on that latest day (or the nearest before tournament)\n",
    "# We'll use a threshold day of 130 as tournament start; if latest day > 130, we might want the one just before.\n",
    "# For simplicity, we'll just take the latest ranking available for that season (assuming it's before tournament).\n",
    "\n",
    "def get_massey_rankings(massey_df):\n",
    "    # Get the maximum day for each season\n",
    "    max_days = massey_df.groupby('Season')['RankingDayNum'].max().reset_index()\n",
    "    max_days.rename(columns={'RankingDayNum': 'MaxDay'}, inplace=True)\n",
    "    \n",
    "    # Merge to filter only rows with that day\n",
    "    massey_latest = massey_df.merge(max_days, on='Season')\n",
    "    massey_latest = massey_latest[massey_latest['RankingDayNum'] == massey_latest['MaxDay']]\n",
    "    \n",
    "    # Now average rank per team and season (across systems)\n",
    "    rank_avg = massey_latest.groupby(['Season', 'TeamID'])['OrdinalRank'].mean().reset_index()\n",
    "    rank_avg.rename(columns={'OrdinalRank': 'AvgMasseyRank'}, inplace=True)\n",
    "    return rank_avg\n",
    "\n",
    "massey_rankings = get_massey_rankings(massey)\n",
    "print(massey_rankings.head())\n",
    "\n",
    "# %% [markdown]\n",
    "# ### 3.3 Merge Team Stats with Rankings\n",
    "\n",
    "# %%\n",
    "team_stats_full = team_stats.merge(massey_rankings, on=['Season', 'TeamID'], how='left')\n",
    "print(team_stats_full.head())\n",
    "\n",
