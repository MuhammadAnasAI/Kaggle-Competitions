    "# Parse sample submission to get all team IDs in 2026 tournament.\n",
    "\n",
    "# %%\n",
    "# Extract Team1 and Team2 from ID\n",
    "sample_sub[['Year', 'Team1ID', 'Team2ID']] = sample_sub['ID'].str.split('_', expand=True)\n",
    "sample_sub['Team1ID'] = sample_sub['Team1ID'].astype(int)\n",
    "sample_sub['Team2ID'] = sample_sub['Team2ID'].astype(int)\n",
    "\n",
    "# Get unique teams\n",
    "tourney_teams = pd.unique(sample_sub[['Team1ID', 'Team2ID']].values.ravel())\n",
    "print(f'Number of unique teams in 2026 tournament: {len(tourney_teams)}')\n",
    "\n",
    "# Filter latest_stats to only these teams\n",
    "latest_stats_tourney = latest_stats[latest_stats['TeamID'].isin(tourney_teams)].copy()\n",
    "print(f'Teams found in latest season data: {len(latest_stats_tourney)}')\n",
